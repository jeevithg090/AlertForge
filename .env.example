# =============================================================================
# SentinelForge — Environment Variables
# Copy to .env and fill in real values. Nothing here is strictly required for a
# working demo: with no LLM key and no tool keys, every model call and external
# service falls back to a realistic mock.
# =============================================================================

# ---- LLM Provider (any OpenAI-compatible API: Groq, Together, vLLM, Ollama) ----
# Default target is Groq running open-source Llama. Free key (30 RPM):
#   https://console.groq.com/keys
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
# Two capability tiers: smart (~70B) for judgment/tools, fast (~8B) for cheap work.
LLM_MODEL_SMART=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
# Optional dedicated reasoning model for the hardest P1/P2 triage (e.g. on Groq:
# deepseek-r1-distill-llama-70b). Leave blank to reason in-line with the smart tier.
LLM_MODEL_REASONING=
LLM_REQUEST_TIMEOUT_SECONDS=60
# Local sentence-transformers model for runbook search (no API cost).
EMBEDDING_MODEL=all-MiniLM-L6-v2
#
# Legacy aliases still accepted (from the project's Qwen origins):
#   DASHSCOPE_API_KEY / QWEN_BASE_URL / QWEN_MODEL_MAX / QWEN_MODEL_PLUS /
#   QWEN_MODEL_FLASH — the new LLM_* names take precedence.

# ---- Database ----
DATABASE_URL=postgresql://sentinelforge:sentinelforge@postgres:5432/sentinelforge
# Used by local scripts / alembic when not running in docker
DATABASE_URL_LOCAL=postgresql://sentinelforge:sentinelforge@localhost:5432/sentinelforge

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# ---- External Tool APIs (leave blank to use mock implementations) ----
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
PROMETHEUS_URL=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Cloudflare IP Access Rules API (free tier — any zone works)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---- MCP Servers ----
# Self-hosted SentinelForge MCP server (mcp_server/) — runs inside compose and
# exposes runbook search + a stubbed JIRA ticket creator over MCP-SSE.
RUNBOOK_MCP_SSE_URL=http://mcp-server:8001/sse
JIRA_MCP_SSE_URL=http://mcp-server:8001/sse
# Optional external tokens (not required for the self-hosted MCP server)
GITHUB_MCP_TOKEN=
JIRA_MCP_TOKEN=

# ---- Authentication / RBAC ----
DEFAULT_ADMIN_PASSWORD=changeme-admin
AUTH_DEV_BYPASS=true   # set false in production — requires Bearer token on every endpoint

# ---- Application ----
SECRET_KEY=change-me-to-a-long-random-string-used-for-hmac-webhook-verification
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# When true, external tool calls return realistic mock data
USE_MOCK_TOOLS=true

# ---- Alert correlation / dedup engine ----
# Fold alerts sharing an entity (IP/user/host) or fingerprint with an OPEN
# incident inside this window into that incident instead of spawning a new run.
CORRELATION_ENABLED=true
CORRELATION_WINDOW_SECONDS=1800

# ---- Action safety / guardrails (deterministic containment authorization) ----
# The LLM proposes; this layer disposes. A DENY here is absolute.
ACTION_DRY_RUN_ONLY=true          # simulate mutations (safe default). Flip per-adapter when validated.
ACTION_KILL_SWITCH=false          # global emergency stop for all mutating actions
ACTION_ENABLED_TYPES=notification,block_ip,suspend_account,isolate_host,rotate_credentials,quarantine_file
# Extra protected targets (added to safe built-ins: RFC1918/loopback, break-glass/service accts, DCs).
ACTION_PROTECTED_IP_CIDRS=        # e.g. 203.0.113.0/24 (your corp egress ranges)
ACTION_PROTECTED_USERS=           # e.g. ceo@corp,cfo@corp (globs allowed)
ACTION_PROTECTED_HOSTS=           # e.g. jump-*,prod-db-*
ACTION_MAX_PER_INCIDENT=10
ACTION_MAX_PER_WINDOW=25
ACTION_WINDOW_SECONDS=300
ACTION_TWO_PERSON_SEVERITIES=P1_CRITICAL   # CRITICAL mutating actions need two distinct approvers

# Auto-approval timeout (minutes) per severity; null = never auto-approve
AUTO_APPROVE_TIMEOUT_P4=5
AUTO_APPROVE_TIMEOUT_P3=15
